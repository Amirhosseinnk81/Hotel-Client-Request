# Copy this file to .env.local and adjust if needed.
# Base URL of the Django backend API.
#
# IMPORTANT: use the same hostname (localhost) the frontend itself is
# served on — NOT 127.0.0.1. The refresh-token cookie is SameSite=Lax, and
# "localhost" and "127.0.0.1" count as two entirely different sites to the
# browser (not just different ports), so a mismatch here silently breaks
# the cookie on every request except the one that first sets it. Run the
# Django dev server as `python manage.py runserver localhost:8000` to match.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
